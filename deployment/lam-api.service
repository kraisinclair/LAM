[Unit]
Description=LAM API - Large Avatar Model FastAPI Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/LAM
Environment="PATH=/opt/LAM/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="PYTHONPATH=/opt/LAM"
ExecStart=/opt/LAM/venv/bin/python app_fastapi.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/LAM /tmp
ProtectHome=true

[Install]
WantedBy=multi-user.target 